# Portfolio — GitHub repo display (read-only)

# Your GitHub username — used to list public repos on the homepage
GITHUB_OWNER=AsmaAfzi

# Optional: raises API rate limits (read-only is enough; no repo create/delete permissions needed)
# Fine-grained: Metadata = Read, Contents = Read (optional)
# Classic: public_repo scope is enough for public repositories
GITHUB_TOKEN=

# --- Only needed if you use the admin CMS (theme / custom project JSON) ---
ADMIN_PASSWORD=
# Use quotes if the value contains # or other special characters
CMS_SESSION_SECRET=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_CONTENT_PREFIX=

# Optional: image uploads in admin CMS
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
